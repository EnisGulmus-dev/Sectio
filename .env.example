# Copy this file to .env for local development. Values below are non-secret examples.
POSTGRES_DB=sectio_db
POSTGRES_USER=sectio_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/sectio_db
DB_USER=sectio_user
DB_PASSWORD=change-me

SESSION_COOKIE_SECURE=false

# Initial administrator bootstrap. Replace these example values locally.
ADMIN_BOOTSTRAP_NAME=Initial Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-temporary-password

